{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "pwe-orchestrator",
  "plugin": [],
  "skill": {
    "pwe-generate-elementor-json": { "path": ".opencode/skills/pwe-generate-elementor-json" },
    "pwe-generate-css": { "path": ".opencode/skills/pwe-generate-css" },
    "pwe-generate-js": { "path": ".opencode/skills/pwe-generate-js" },
    "pwe-plan-component": { "path": ".opencode/skills/pwe-plan-component" },
    "pwe-build-elementor-structure": { "path": ".opencode/skills/pwe-build-elementor-structure" },
    "pwe-read-design-system": { "path": ".opencode/skills/pwe-read-design-system" },
    "pwe-validate-component": { "path": ".opencode/skills/pwe-validate-component" },
    "pwe-apply-patch": { "path": ".opencode/skills/pwe-apply-patch" },
    "pwe-catalog-component": { "path": ".opencode/skills/pwe-catalog-component" },
    "pwe-analyze-site-structure": { "path": ".opencode/skills/pwe-analyze-site-structure" },
    "pwe-analyze-site-styles": { "path": ".opencode/skills/pwe-analyze-site-styles" },
    "pwe-compare-sites": { "path": ".opencode/skills/pwe-compare-sites" },
    "pwe-extract-design-tokens": { "path": ".opencode/skills/pwe-extract-design-tokens" },
    "pwe-sync-tokens-to-ds": { "path": ".opencode/skills/pwe-sync-tokens-to-ds" },
    "pwe-analyze-problem": { "path": ".opencode/skills/pwe-analyze-problem" },
    "pwe-find-root-cause": { "path": ".opencode/skills/pwe-find-root-cause" },
    "pwe-propose-improvement": { "path": ".opencode/skills/pwe-propose-improvement" },
    "pwe-generate-improvement-patch": { "path": ".opencode/skills/pwe-generate-improvement-patch" },
    "pwe-plan-theme": { "path": ".opencode/skills/pwe-plan-theme" },
    "pwe-generate-child-theme": { "path": ".opencode/skills/pwe-generate-child-theme" },
    "pwe-validate-theme": { "path": ".opencode/skills/pwe-validate-theme" }
  },
  "agent": {
    "pwe-orchestrator": {
      "mode": "primary",
      "permission": {
        "external_directory": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": {
          "*": "deny",
          ".opencode/standards/**": "allow",
          ".opencode/skills/pwe-*/SKILL.md": "allow",
          ".opencode/knowledge/**": "allow",
          ".opencode/agents/pwe-elementor-architect.md": "allow",
          ".opencode/agents/pwe-site-analyst.md": "allow",
          ".opp/backups/**": "allow",
          ".opp/components/**": "allow",
          ".opp/docs/**": "allow"
        },
        "bash": {
          "*": "deny",
          "node .opencode/skills/pwe-validate-component/validate-component.mjs *": "allow"
        },
        "task": {
          "*": "deny",
          "pwe-elementor-architect": "allow",
          "pwe-site-analyst": "allow",
          "pwe-theme-builder": "allow",
          "pwe-reviewer": "allow",
          "pwe-improvement-engineer": "allow"
        },
        "skill": { "*": "deny", "pwe-*": "allow" },
        "question": "allow"
      }
    }
  }
}
